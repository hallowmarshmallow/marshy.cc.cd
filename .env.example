# ---- Supabase (backend) ----
# Copy this file to .env and fill in real values. NEVER commit .env.
# Get both values from supabase.com → your project → Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Notes:
# - The anon key is a PUBLISHABLE key, not a secret; it is safe to ship in the
#   frontend bundle. Real security comes from Row Level Security policies.
# - The service_role key must NEVER be placed in this file or any frontend code.
